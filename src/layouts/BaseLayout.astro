---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}
const {
  title = 'Barney Pinkerton',
  description = 'Barney Pinkerton — NYU Music Business & Music Technology student. Projects in music data, machine learning and analytics, plus essays on music and culture.',
  hideFooter = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/assets/images/headshot.jpg', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/assets/images/favicon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Barney Pinkerton" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />

  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <nav class="masthead">
    <div class="masthead__inner">
      <a href="/" class="site-title">Barney Pinkerton</a>
      <div class="nav-links">
        <a href="/projects" class:list={{ active: path.startsWith('/projects') }} aria-current={path.startsWith('/projects') ? 'page' : undefined}>Projects</a>
        <a href="/writing" class:list={{ active: path.startsWith('/writing') }} aria-current={path.startsWith('/writing') ? 'page' : undefined}>Writing</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  {!hideFooter && (
    <footer class="site-footer">
      <div class="footer-links">
        <a href="mailto:barneyjpinkerton@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/barney-p-49b439178" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/barneypinkerton" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} Barney Pinkerton. Built with Astro.</p>
    </footer>
  )}

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
